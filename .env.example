# ============================================================================
#  心理健康 AI 服务平台 —— 环境变量配置
#
#  用法：把本文件复制为同目录下的  .env  并填入真实密钥
#        start.bat 会自动加载 .env，无需手动 set 环境变量
#
#  ⚠️  .env 已被 .gitignore 忽略，请勿把真实密钥提交进仓库
# ============================================================================

# ---------------------------------------------------------------------------
# 必填：DeepSeek —— 对话生成、工具调用、情绪分析
# 获取：https://platform.deepseek.com
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=

# ---------------------------------------------------------------------------
# 必填：阿里云百炼 —— 知识库向量化（Embedding，text-embedding-v3，1024 维）
# 获取：https://bailian.console.aliyun.com
#
# ⚠️ 注意区域：本项目默认使用「国际站」dashscope-intl.aliyuncs.com
#    若你的 Key 属于中国站，请把 application.yml 中的 embedding.base-url
#    改为 https://dashscope.aliyuncs.com/compatible-mode ，否则会返回 401
# ---------------------------------------------------------------------------
DASHSCOPE_API_KEY=

# ---------------------------------------------------------------------------
# 以下均可选：不填也能启动（application.yml 中已有面向本地开发的默认值）
# 生产环境必须显式配置
# ---------------------------------------------------------------------------

# MySQL 连接（默认 localhost:3306 / root / 1234）
# MYSQL_URL=jdbc:mysql://localhost:3306/mental_health_assistant?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
# MYSQL_USERNAME=root
# MYSQL_PASSWORD=1234

# JWT 签名密钥（🔴 生产环境必须修改；使用默认值等同于公开签名密钥）
# JWT_SECRET=dev-only-secret-change-me-in-production
